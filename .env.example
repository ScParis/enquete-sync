# Exemplo de Variáveis de Ambiente para Produção
# Copie este arquivo para .env e customize os valores conforme necessário.

# Porta da aplicação
PORT=8766
NODE_ENV=production

# Caminho para o perfil do navegador persistente (cookies de sessão do G-Click)
GCLICK_PROFILE_DIR=./data/browser-profile

# Credenciais iniciais do Superadministrador (criado na primeira inicialização do banco SQLite)
INITIAL_ADMIN_EMAIL=admin@gclick.local
INITIAL_ADMIN_PASSWORD=Admin@123456

# Chave secreta de sessão ou token interno (opcional)
GCLICK_TOKEN=
